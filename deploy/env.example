# /etc/wa-bridge/env  --  chown root:wa-bridge, chmod 0640 (or 0600 root-only
# if systemd reads it as root, which it does).
#
# Deployment identity and secrets only. Policy lives in config.toml, which is
# reviewable and diffable; nothing here can enable sending, add a conversation,
# raise a quota or widen the sender allowlist (README 9.1).

WA_BRIDGE_MAIL_DOMAIN=wa.example.com
WA_BRIDGE_MAILBOX=bridge@wa.example.com
WA_BRIDGE_ASSISTANT_ADDRESS=assistant@mail.instinct.com

WA_BRIDGE_IMAP_HOST=imap.provider.net
WA_BRIDGE_IMAP_USER=bridge@wa.example.com
WA_BRIDGE_IMAP_PASSWORD=

WA_BRIDGE_SMTP_HOST=smtp.provider.net
WA_BRIDGE_SMTP_USER=bridge@wa.example.com
WA_BRIDGE_SMTP_PASSWORD=

# At least 32 bytes. Signs every token and Message-ID; a weak one makes them
# forgeable, and the bridge refuses to start if it is short.
#   openssl rand -base64 48
WA_BRIDGE_HMAC_KEY=

WA_BRIDGE_STATE_DIR=/var/lib/wa-bridge
WA_BRIDGE_CONFIG=/etc/wa-bridge/config.toml

# Optional, and may only tighten. Uncomment to force draft-only regardless of
# what the policy file permits.
#WA_BRIDGE_MODE=draft-only
